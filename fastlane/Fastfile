require "pathname"
require "base64"
require "csv"
require "fileutils"
require "json"
require "net/http"
require "open-uri"
require "openssl"
require "shellwords"
require "uri"

default_platform(:android)

def required_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing #{name}") if value.empty?
  value
end

def optional_env(name)
  value = ENV[name].to_s.strip
  value.empty? ? nil : value
end

def testflight_sheet_csv_url
  explicit_url = optional_env("TESTFLIGHT_TESTERS_CSV_URL")
  return explicit_url if explicit_url

  sheet_id = optional_env("TESTFLIGHT_GOOGLE_SHEET_ID")
  return nil unless sheet_id

  gid = optional_env("TESTFLIGHT_GOOGLE_SHEET_GID") || "0"
  "https://docs.google.com/spreadsheets/d/#{sheet_id}/export?format=csv&gid=#{gid}"
end

def google_service_account_key_path
  raw_path = optional_env("TESTFLIGHT_GOOGLE_SERVICE_ACCOUNT_JSON_PATH") || optional_env("PLAY_JSON_KEY")
  return nil unless raw_path

  Pathname.new(raw_path).absolute? ? raw_path : File.expand_path("../#{raw_path}", __dir__)
end

def base64url(value)
  Base64.urlsafe_encode64(value).delete("=")
end

def google_service_account_access_token(key_path)
  key = JSON.parse(File.read(key_path))
  now = Time.now.to_i
  scope = "https://www.googleapis.com/auth/spreadsheets.readonly"
  header = { alg: "RS256", typ: "JWT" }
  claim_set = {
    iss: key.fetch("client_email"),
    scope: scope,
    aud: "https://oauth2.googleapis.com/token",
    exp: now + 3600,
    iat: now
  }

  unsigned_jwt = "#{base64url(JSON.generate(header))}.#{base64url(JSON.generate(claim_set))}"
  private_key = OpenSSL::PKey::RSA.new(key.fetch("private_key"))
  signature = private_key.sign(OpenSSL::Digest::SHA256.new, unsigned_jwt)
  assertion = "#{unsigned_jwt}.#{base64url(signature)}"

  response = Net::HTTP.post_form(
    URI("https://oauth2.googleapis.com/token"),
    "grant_type" => "urn:ietf:params:oauth:grant-type:jwt-bearer",
    "assertion" => assertion
  )
  body = JSON.parse(response.body)

  unless response.is_a?(Net::HTTPSuccess)
    UI.user_error!("Unable to authenticate Google service account: #{body["error_description"] || body["error"] || response.body}")
  end

  body.fetch("access_token")
end

def read_private_google_sheet_csv
  sheet_id = optional_env("TESTFLIGHT_GOOGLE_SHEET_ID")
  return nil unless sheet_id

  key_path = google_service_account_key_path
  unless key_path && File.exist?(key_path)
    UI.user_error!("Missing Google service account JSON. Set TESTFLIGHT_GOOGLE_SERVICE_ACCOUNT_JSON_PATH or PLAY_JSON_KEY.")
  end

  range = optional_env("TESTFLIGHT_GOOGLE_SHEET_RANGE") || "Testers!A:D"
  token = google_service_account_access_token(key_path)
  uri = URI("https://sheets.googleapis.com/v4/spreadsheets/#{sheet_id}/values/#{URI.encode_www_form_component(range)}")
  uri.query = URI.encode_www_form(
    "majorDimension" => "ROWS",
    "valueRenderOption" => "FORMATTED_VALUE"
  )

  request = Net::HTTP::Get.new(uri)
  request["Authorization"] = "Bearer #{token}"
  response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(request) }
  body = JSON.parse(response.body)

  unless response.is_a?(Net::HTTPSuccess)
    message = body.dig("error", "message") || response.body
    UI.user_error!("Unable to read private Google Sheet: #{message}")
  end

  values = body["values"] || []
  UI.user_error!("No rows found in Google Sheet range #{range}") if values.empty?

  CSV.generate do |csv|
    values.each { |row| csv << row }
  end
end

def row_value(row, *keys)
  keys.each do |key|
    value = row[key]
    return value.to_s.strip if value && !value.to_s.strip.empty?
  end

  ""
end

def normalize_groups(value)
  value
    .to_s
    .split(/[;,]/)
    .map(&:strip)
    .reject(&:empty?)
    .join(";")
end

def known_email_header?(value)
  normalized = value.to_s.strip.downcase.gsub(/[\s-]+/, "_")
  ["email", "e_mail", "mail", "adresse_email", "adresse_mail"].include?(normalized)
end

def normalized_header(value)
  value.to_s.strip.downcase.gsub(/[\s-]+/, "_")
end

def add_testflight_tester(testers_by_email, email, first_name, last_name, groups, default_groups)
  email = email.to_s.strip.downcase
  return if email.empty?

  unless email.match?(/\A[^@\s]+@[^@\s]+\.[^@\s]+\z/)
    UI.user_error!("Invalid TestFlight tester email in Google Sheet: #{email}")
  end

  groups = normalize_groups(groups)
  groups = default_groups if groups.empty?

  if groups.empty?
    UI.user_error!("Missing TestFlight group for #{email}. Add a groups column or set TESTFLIGHT_DEFAULT_GROUPS.")
  end

  testers_by_email[email] = [
    first_name.to_s.strip,
    last_name.to_s.strip,
    email,
    groups
  ]
end

def normalize_testflight_testers(input_csv, output_csv)
  default_groups = normalize_groups(optional_env("TESTFLIGHT_DEFAULT_GROUPS"))
  testers_by_email = {}
  rows = CSV.parse(input_csv)

  UI.user_error!("No TestFlight testers found in Google Sheet CSV") if rows.empty?

  if rows.first.any? { |cell| known_email_header?(cell) }
    headers = rows.shift.map { |header| normalized_header(header) }
    rows.each do |row|
      values = headers.zip(row).to_h
      add_testflight_tester(
        testers_by_email,
        row_value(values, "email", "e_mail", "mail", "adresse_email", "adresse_mail"),
        row_value(values, "first_name", "firstname", "first", "prenom", "prénom"),
        row_value(values, "last_name", "lastname", "last", "nom"),
        row_value(values, "groups", "group", "testflight_groups", "testflight_group"),
        default_groups
      )
    end
  else
    rows.each do |row|
      add_testflight_tester(
        testers_by_email,
        row[0],
        "",
        "",
        "",
        default_groups
      )
    end
  end

  UI.user_error!("No TestFlight testers found in Google Sheet CSV") if testers_by_email.empty?

  FileUtils.mkdir_p(File.dirname(output_csv))
  CSV.open(output_csv, "w") do |csv|
    testers_by_email.values.sort_by { |tester| tester[2] }.each { |tester| csv << tester }
  end

  testers_by_email.length
end

def write_app_store_connect_api_key_json(path)
  raw_key_filepath = required_env("P8_FILE_PATH")
  key_filepath = Pathname.new(raw_key_filepath).absolute? ? raw_key_filepath : File.expand_path("../#{raw_key_filepath}", __dir__)
  payload = {
    key_id: required_env("P8_KEY_ID"),
    issuer_id: required_env("P8_ISSUER_ID"),
    key_filepath: key_filepath,
    in_house: false
  }

  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(payload))
end

def collect_emails_from_csv(path)
  return [] unless File.exist?(path)

  CSV
    .read(path)
    .flat_map { |row| row.compact.map(&:to_s) }
    .map(&:strip)
    .select { |value| value.match?(/\A[^@\s]+@[^@\s]+\.[^@\s]+\z/) }
    .map(&:downcase)
    .uniq
    .sort
end

def remove_existing_testflight_testers(api_key_json_path, app_identifier)
  existing_testers_csv_path = File.expand_path("../.ci/existing-testflight-testers.csv", __dir__)
  FileUtils.rm_f(existing_testers_csv_path)

  UI.message("Exporting existing external TestFlight testers")
  sh(
    "fastlane pilot export " \
    "-c #{Shellwords.escape(existing_testers_csv_path)} " \
    "-a #{Shellwords.escape(app_identifier)} " \
    "--api_key_path #{Shellwords.escape(api_key_json_path)}"
  )

  emails = collect_emails_from_csv(existing_testers_csv_path)
  if emails.empty?
    UI.message("No existing external TestFlight testers to remove")
    return
  end

  UI.message("Removing #{emails.length} existing external TestFlight tester(s)")
  emails.each do |email|
    sh(
      "fastlane pilot remove #{Shellwords.escape(email)} " \
      "-a #{Shellwords.escape(app_identifier)} " \
      "--api_key_path #{Shellwords.escape(api_key_json_path)}"
    )
  end
end

def import_testflight_testers_from_google_sheet
  csv_url = testflight_sheet_csv_url
  private_sheet_csv = read_private_google_sheet_csv
  unless private_sheet_csv || csv_url
    UI.important("Skipping TestFlight tester sync: set TESTFLIGHT_GOOGLE_SHEET_ID or TESTFLIGHT_TESTERS_CSV_URL to enable it.")
    return
  end

  generated_csv_path = File.expand_path("../.ci/testflight-testers.csv", __dir__)
  api_key_json_path = File.expand_path("../.ci/app-store-connect-api-key.json", __dir__)
  app_identifier = optional_env("TESTFLIGHT_APP_IDENTIFIER") || "fr.reactif"

  input_csv = private_sheet_csv
  unless input_csv
    UI.message("Downloading TestFlight testers from Google Sheet CSV export")
    input_csv = URI.open(csv_url, &:read)
  end

  tester_count = normalize_testflight_testers(input_csv, generated_csv_path)
  write_app_store_connect_api_key_json(api_key_json_path)
  remove_existing_testflight_testers(api_key_json_path, app_identifier)

  UI.message("Importing #{tester_count} TestFlight tester(s)")
  sh(
    "fastlane pilot import " \
    "-c #{Shellwords.escape(generated_csv_path)} " \
    "-a #{Shellwords.escape(app_identifier)} " \
    "--api_key_path #{Shellwords.escape(api_key_json_path)}"
  )
end

platform :ios do
  desc "Create or sync App Store signing assets used for TestFlight"
  lane :testflight_release do
    setup_ci

    api_key = app_store_connect_api_key(
        key_id: required_env("P8_KEY_ID"),
        issuer_id: required_env("P8_ISSUER_ID"),
        key_filepath: required_env("P8_FILE_PATH"),
        in_house: false
    )
    match(api_key: api_key)
    build_app(workspace: "ios/Reactif.xcworkspace", scheme: "Reactif", export_method: "app-store") # Change name of workspace

    upload_to_testflight(changelog: ENV["CHANGELOG"] || "Pas de note de mise à jour fournie. Merci de consulter le changelog in-app.")
    import_testflight_testers_from_google_sheet
  end

  desc "Import TestFlight external testers from a Google Sheet CSV export"
  lane :sync_testflight_testers do
    import_testflight_testers_from_google_sheet
  end
end

platform :android do
  desc "Upload Android AAB to Google Play Internal track with changelog metadata"
  lane :internal_release do |options|
    project_root = File.expand_path("..", __dir__)

    raw_aab_path = options[:aab] || ENV["AAB_PATH"] || "android/app/build/outputs/bundle/release/app-release.aab"
    track = options[:track] || ENV["PLAY_TRACK"] || "internal"
    release_status = options[:release_status] || ENV["PLAY_RELEASE_STATUS"] || "draft"
    raw_json_key_path = options[:json_key] || ENV["PLAY_JSON_KEY"]
    raw_metadata_path = options[:metadata_path] || ENV["PLAY_METADATA_PATH"] || ".ci/play-metadata/android"

    aab_path = Pathname.new(raw_aab_path).absolute? ? raw_aab_path : File.expand_path(raw_aab_path, project_root)
    json_key_path = if raw_json_key_path.to_s.strip.empty?
      raw_json_key_path
    else
      Pathname.new(raw_json_key_path).absolute? ? raw_json_key_path : File.expand_path(raw_json_key_path, project_root)
    end
    metadata_path = Pathname.new(raw_metadata_path).absolute? ? raw_metadata_path : File.expand_path(raw_metadata_path, project_root)

    if !File.exist?(aab_path)
      fallback_aab = Dir
        .glob(File.join(project_root, "android/app/build/outputs/**/*.aab"))
        .max_by { |p| File.mtime(p) }

      if fallback_aab
        UI.important("AAB not found at #{aab_path}. Using detected bundle: #{fallback_aab}")
        aab_path = fallback_aab
      end
    end

    UI.user_error!("Missing Google Play service account json path. Set PLAY_JSON_KEY or pass json_key.") if json_key_path.to_s.strip.empty?
    UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Google Play json key file not found at #{json_key_path}") unless File.exist?(json_key_path)

    supply(
      aab: aab_path,
      track: track,
      release_status: release_status,
      json_key: json_key_path,
      metadata_path: metadata_path,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_metadata: true
    )
  end
end
